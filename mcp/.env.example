# Copie para .env (cp .env.example .env) e preencha. O .env NUNCA vai pro Git.

# Endereço público da VPS. Sem domínio? Use o IP com sslip.io, ex.: 203-0-113-10.sslip.io
DOMAIN=

# Segredo do MCP e da rota de voz. Gere com: openssl rand -hex 32
MCP_TOKEN=

# Supabase do Duzz Finance (os mesmos do app: VITE_SUPABASE_URL e VITE_SUPABASE_PUBLISHABLE_KEY)
SUPABASE_URL=https://wenjxwdxsdvmfmmaschn.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Seu login do app. O servidor entra como você, então só enxerga os seus dados (RLS).
DUZZ_EMAIL=
DUZZ_PASSWORD=

# Conta usada quando você não fala nenhuma (nome igual ao do app). Vazio = primeira conta corrente.
DEFAULT_ACCOUNT=Conta principal

# Open Finance (opcional): puxa as transações dos seus bancos automaticamente.
# 1) Conecte os bancos em https://meu.pluggy.ai  2) em https://dashboard.pluggy.ai, na aplicação demo,
# copie o Client ID / Client Secret e o id de cada item (banco) conectado. Veja "Open Finance" no README.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# ids dos itens separados por vírgula (um por banco)
PLUGGY_ITEMS=
# de quantas em quantas horas sincronizar (o Meu Pluggy atualiza os bancos 1x por dia)
PLUGGY_SYNC_HOURS=6
# quantos dias para trás trazer na primeira sincronização de cada conta
PLUGGY_FIRST_SYNC_DAYS=90

# Modelo do Whisper: tiny, base, small (recomendado, ~1 GB de RAM), medium (~2,5 GB, mais preciso e mais lento)
WHISPER_MODEL=small
# Núcleos de CPU para o Whisper (0 = automático)
WHISPER_THREADS=0
